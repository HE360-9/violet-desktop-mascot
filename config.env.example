# ===== 大模型（必填）=====
# 火山方舟 API Key：https://console.volcengine.com/ark
ARK_API_KEY = ""
# 兼容 OpenAI 的 chat/completions 接口
API_URL = "https://ark.cn-beijing.volces.com/api/v3/chat/completions"
# 接入点 ID（ep-...）或模型 ID
LLM_MODEL_NAME = "doubao-seed-2-0-lite-260428"
TEMPERATURE = 0.7
# 思考 + 正文合计上限，太小会把回答截断
MAX_TOKENS = 600
# 思考过程：off / on / auto，角色闲聊建议 off
LLM_THINKING = off

# ===== 语音合成 GPT-SoVITS（可选）=====
ENABLE_TTS = false
TTS_API_URL = http://127.0.0.1:9880
# api_v2.bat 的完整路径
TTS_BAT_PATH = ""
# 3~10 秒参考音频（.wav）
TTS_REF_AUDIO_PATH = ""
# 必须逐字填写参考音频里说的话，否则音色会乱
TTS_PROMPT_TEXT = ""
# 参考音频语言：zh / ja / en
TTS_PROMPT_LANG = ja
TTS_OUTPUT_DIR = ./tts_output
TTS_TIMEOUT = 180
# 语速：1.0 原速，范围 0.5 ~ 2.0
TTS_SPEED_FACTOR = 1.15
# 逐句响度归一化：目标响度（LUFS）与峰值上限（dBTP）
TTS_TARGET_LUFS = -20
TTS_TRUE_PEAK = -1.5
